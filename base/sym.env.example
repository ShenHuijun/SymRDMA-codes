# sym.env.example — key table for $SYM_HOME/sym.env (default: ~/sym/sym.env).
# sym.env is GENERATED by ./base/sym env from the machine's hardware facts and
# the install record ($SYM_HOME/install.state, written by ./base/sym install).
# This template documents the keys; do not hand-edit sym.env — rerun sym env.
#
# Source it before configuring SymRDMA clients:   . ~/sym/sym.env
#
# Manual link selection: on a host with several RDMA-capable links, write the
# chosen link into ~/sym/sym.conf (hand-edited, never generated by sym):
#
#     SYM_IP=<rdma-fabric-ipv4>  # optional: pin the RDMA fabric address
#     SYM_NETDEV=<netdev>        # optional: pin the netdev; combinable with SYM_IP
#
# sym env then resolves that link and keeps its consistency red line (the
# GID's IPv4 must equal the netdev address). The <...> placeholders above are
# examples only; every machine writes its own probed values.
#
# The device key keeps its historical name because the shipped test programs
# read it directly. The coordinate keys are the tool's own view; mapping them
# onto the test programs' variables is done by the test-side tooling, not here.

# --- module load configuration (from the install record) ---------------------
#
# SYM_MODE        load mode of symrdma: 1 = NIC mode (attached to a port),
#                 0 = standalone verify mode
# SYM_PCI_BDF     PCI address of the attached port, <domain:bus:dev.fn>

SYM_MODE=1
SYM_PCI_BDF=<domain:bus:dev.fn>

# --- local port coordinates (probed hardware facts of THIS machine) ----------
#
# NP_RDMA_DEV     RDMA device name (mlx5_*), as read by the test programs
# SYM_RDMA_NETDEV netdev carrying the port's IPv4 address
# SYM_RDMA_IP     IPv4 address of that netdev
# SYM_RDMA_GID    RoCE v2 GID index whose IPv4 equals SYM_RDMA_IP (red line:
#                 sym env fails when the GID's IPv4 and the netdev disagree)
# SYM_RDMA_MTU    active MTU of the port, in bytes

NP_RDMA_DEV=mlx5_0
SYM_RDMA_NETDEV=<netdev>
SYM_RDMA_IP=<local-ipv4>
SYM_RDMA_GID=<gid-index>
SYM_RDMA_MTU=1024

# --- install identity (copied from $SYM_HOME/install.state) ------------------
#
# SYM_SRC_COMMIT       commit of the source tree that was installed ("none"
#                      outside a git checkout)
# SYM_SRC_HASH         sha256 over the kernel/ nprdma/ sources
# SYM_KO_PATH          absolute path of the deployed symrdma.ko
# SYM_KO_SHA256        sha256 of that file (forensics only, never compared)
# SYM_KO_SRCVERSION    srcversion of the deployed ko (modinfo -F srcversion)
# SYM_SRCVERSION       srcversion of the LOADED module
#                      (/sys/module/symrdma/srcversion)
# SYM_LOADED_AT        UTC time of the last module load
# SYM_KERNEL_RELEASE   kernel the module was built and loaded for
# SYM_OFED_VERSION     MLNX_OFED version string
# SYM_OFED_FILES       digest of the six shipped OFED source files (ofed/BASELINE),
#                      "external" when --skip-ofed was used
# SYM_OFED_ANCHORS     digest of the lineage anchors (ofed/BASELINE), "external"
#                      with --skip-ofed
# SYM_MLX5_PARAMS      ok when the identity-MTT module parameters are in place
#                      (/sys/module/mlx5_ib/parameters/identity_mtt), else missing
#
# Same-version checks compare only values of the same kind: loaded
# SYM_SRCVERSION == deployed SYM_KO_SRCVERSION on one machine;
# SYM_SRC_HASH equal across machines.

SYM_SRC_COMMIT=<sha|none>
SYM_SRC_HASH=<sha256>
SYM_KO_PATH=<absolute path>
SYM_KO_SHA256=<sha256>
SYM_KO_SRCVERSION=<srcversion>
SYM_SRCVERSION=<srcversion>
SYM_LOADED_AT=<utc-timestamp>
SYM_KERNEL_RELEASE=<kernel-release>
SYM_OFED_VERSION=<ofed-version>
SYM_OFED_FILES=<digest|external>
SYM_OFED_ANCHORS=<digest|external>
SYM_MLX5_PARAMS=<ok|missing>
