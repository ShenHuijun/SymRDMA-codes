+/* SymRDMA: MTT identity mapping (论文 §4.2)。
+ *
+ * ★ 命名辨析 (两层 "identity" 不是一回事):
+ *   - 本参数:  MTT 条目 = 用户 VA (IOVA == VA) — 硬件仍经 IOMMU 翻译。
+ *              系统必须保持 IOMMU 翻译模式 (intel_iommu=on, 非 iommu=pt)。
+ *   - IOMMU passthrough 的 identity: IOVA == PA, 不做翻译 (iommu=pt) —
+ *              与本文档无关, 且与 SymRDMA 互斥 (symrdma.ko 会拒绝附加)。
+ *
+ * 语义: 开启后用户 MR 的 MTT 条目 = 用户 VA，地址翻译完全交给系统
+ * IOMMU —— SymRDMA 内核模块已在 NIC 的 IOMMU 域中映射
+ * VA → 真实PA / 哨兵页 / 黑洞页。仅影响用户 MR 的 MTT，
+ * QP/CQ/SRQ 缓冲区仍走 dma_map (dma IOVA)。
+ *
+ * 影响: (1) 所有用户 MR 的 DMA 缓冲区都必须有 SymRDMA IOMMU 映射,
+ * 否则 DMA fault (未 hook 应用直接故障);
+ * (2) IOMMU 页表粒度 4KB (用户 VA 碎片) → IOTLB 压力, 性能影响
+ * 
+ *
+ * 加载时固定 (0444 只读) — 切换需重载模块。
+ * 0 (默认) = 按 MR 选择性激活: 带 SYMRDMA_ACCESS_IDENTITY 标记位
+ *   (1<<21, libnprdma/libsymrdma 注入) 的 MR 走 identity, 普通应用
+ *   完全原版路径 (论文 §4.2 "unaffected", P4/);
+ * 1 = 全局强制: 所有用户 MR 走 identity (未 hook 应用会 DMA fault)。
+ */
+bool mlx5_ib_identity_mtt;
+module_param_named(identity_mtt, mlx5_ib_identity_mtt, bool, 0444);
+MODULE_PARM_DESC(identity_mtt,
+		 "SymRDMA: MTT entries = user VA (IOVA==VA), IOMMU translates. NOT iommu passthrough. 0=vanilla behavior");
+
+/* SymRDMA: write-only MR (REMOTE_WRITE 无 REMOTE_READ) 的 MTT 偏移。
+ * 写区域 MTT 条目 = VA + 偏移 → NIC DMA 经 IOMMU 命中 write_iova
+ * (驻留→真实PA, 缺失→黑洞页), 哨兵页不被写入污染。
+ * 取值须与 SymRDMA 内核模块的 SYMRDMA_MR_WRITE_OFFSET 一致 (32GB)。
+ * 默认 0 = 关闭 (写区域退化为 MTT=VA, 与 identity_mtt 单 VA 行为相同)。 */
+u64 mlx5_ib_identity_mtt_womr_offset;
+module_param_named(identity_mtt_write_offset, mlx5_ib_identity_mtt_womr_offset,
+		   ullong, 0444);
+MODULE_PARM_DESC(identity_mtt_write_offset,
+		 "SymRDMA: MTT offset (bytes) for write-only MRs (REMOTE_WRITE w/o REMOTE_READ), e.g. 34359738368");
+
+/* SymRDMA (论文 §4.2): identity MTT 条目页大小 (log2)。
+ * 默认 31 = 2GB (mkc.log_page_size 5 位字段上限, NIC 原生大页):
+ * 128GB MR 仅 64 条目 → on-chip MTT cache 结构性不 miss。
+ * 条目值 = 用户 VA 基址 (恒等): HW 计算 PA = MTT[k] + 段内偏移,
+ * 段基址 4KB 对齐即可 (应用 VA 天然满足), 无需物理对齐。
+ * reg_create/pas_identity/缓冲区全长 page_size 自适应; 异常时置 12
+ * 回退 4KB 逐页。 */
+unsigned int mlx5_ib_identity_mtt_log_pgsize = 31;
+module_param_named(identity_mtt_log_pgsize, mlx5_ib_identity_mtt_log_pgsize,
+		   uint, 0444);
+MODULE_PARM_DESC(identity_mtt_log_pgsize,
+		 "SymRDMA: identity MTT entry log2 page size (12-31, default 31=2GB, paper 4.2)");
