 /*
+ * SymRDMA: identity 版本 — MTT 条目直接填用户 VA (论文 §4.2)。
+ * 地址翻译完全交给系统 IOMMU: SymRDMA 内核模块已在 NIC 的 IOMMU 域中
+ * 映射 VA → 真实PA / 哨兵页 / 黑洞页。
+ * 仅由 MR 注册路径调用 (mr.c)；QP/CQ/SRQ 缓冲区仍走 dma IOVA。
+ *
+ * va_offset: write-only MR (写区域) 的偏移 — 条目 = VA + 偏移,
+ * 使 RDMA Write 命中 write_iova (驻留→真实PA, 缺失→黑洞页)。
+ */
+void mlx5_ib_populate_pas_identity(u64 va_start, size_t length,
+				   size_t page_size, __be64 *pas,
+				   u64 access_flags)
+{
+	/*
+	 *  按页数迭代 — 不能用 rdma_umem_for_each_dma_block
+	 * (它按 sg 链表迭代; no-pin umem 的 sg 为空 → 循环 0 次 →
+	 * MTT 全空 → responder NAK/RETRY_EXCEEDED, no-pin 实测教训)。
+	 *  改为显式 (va_start, length) — 2GB 大页条目下 MKEY
+	 * start_addr 下取整到条目边界、长度扩展, 条目数按扩展后长度计。
+	 */
+	size_t npages = DIV_ROUND_UP(length, page_size);
+	size_t i;
+	u64 va = va_start;
+
+	for (i = 0; i < npages; i++) {
+		*pas = cpu_to_be64(va | access_flags);
+		va += page_size;
+		pas++;
+	}
+}
